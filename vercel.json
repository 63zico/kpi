{
  "version": 2,
  "routes": [
    {
      "src": "/staff.html",
      "status": 308,
      "headers": {
        "Location": "/levelove-staff-9c4f2a7.html"
      }
    },
    {
      "src": "/store-settings.html",
      "status": 308,
      "headers": {
        "Location": "/levelove-store-9c4f2a7.html"
      }
    },
    {
      "src": "/kitchen.html",
      "status": 308,
      "headers": {
        "Location": "/levelove-admin-9c4f2a7.html#team"
      }
    },
    {
      "src": "/bonus-settings.html",
      "status": 308,
      "headers": {
